{
  "name": "@nestarc/data-subject",
  "version": "0.2.0",
  "description": "DPA-ready GDPR/CCPA toolkit for NestJS + Prisma. Entity registry, export/erase lifecycle, legal retention, outbox fan-out.",
  "license": "MIT",
  "author": "nestarc",
  "repository": "github:nestarc/data-subject",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "require": "./dist/lint/index.js",
      "default": "./dist/lint/index.js"
    }
  },
  "bin": {
    "data-subject": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/code-review-src.md",
    "docs/compliance.md",
    "docs/data-subject-0.2.0-feature-proposal.md",
    "docs/data-subject-0.2.0-spec.md",
    "docs/prd.md",
    "docs/spec.md",
    "prisma",
    "README.md",
    "LICENSE",
    "docs/compatibility.md",
    "docs/p0-migration.md",
    "docs/p1-migration.md",
    "docs/private-artifacts.md",
    "docs/p2-execution.md",
    "docs/platform-integration.md",
    "docs/nestarc-composition.md",
    "docs/p2-support-proposal.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "bench": "ts-node bench/data-subject.bench.ts",
    "bench:check": "tsc -p bench/tsconfig.json",
    "bench:smoke": "npm run bench -- --iterations 1 --warmup 0 --rows 7 --batch-size 3",
    "examples:check": "tsc -p examples/tsconfig.json && node --check examples/private-artifacts/aws-sdk-v3.cjs",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"bench/**/*.ts\" \"examples/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "test:compatibility": "node test/compatibility/run.cjs",
    "test:composition": "node test/composition/run.cjs"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.2.7",
    "@nestjs/core": "^10.0.0 || ^11.2.7",
    "@prisma/client": "^5.0.0 || ^7.10.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@prisma/client": "^5.10.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
