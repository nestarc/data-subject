model Profile {
  id           String @id
  tenantId     String
  subjectId    String
  email        String
  passwordHash String
  accessToken  String
  @@index([tenantId, subjectId])
}

model Invoice {
  id        String @id
  tenantId  String
  subjectId String
  email     String?
  total     Int
  @@index([tenantId, subjectId])
}

model GraphAccount {
  id        String @id
  tenantId  String
  subjectId String
  email     String
  sessions  GraphSession[]
  @@index([tenantId, subjectId])
}

model GraphSession {
  id        String @id
  tenantId  String
  subjectId String
  accountId String
  token     String?
  account   GraphAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([tenantId, subjectId])
}

model BatchItem {
  id           String @id
  tenantId     String
  subjectId    String
  email        String?
  total        Int
  passwordHash String?
  @@index([tenantId, subjectId, id])
}

model ScalarItem {
  id              String @id
  tenantId        String
  subjectId       String
  happenedAt      DateTime?
  decimalNumber   Decimal?
  decimalString   Decimal?
  bigintNumber    BigInt?
  bigintString    BigInt?
  retainedDecimal Decimal?
  @@index([tenantId, subjectId, id])
}

model CompositeParent {
  id        String @id
  tenantId  String
  subjectId String
  email     String
  children  CompositeChild[]
  @@unique([tenantId, id])
}

model CompositeChild {
  id        String @id
  tenantId  String
  subjectId String
  parentId  String?
  total     Int
  parent    CompositeParent? @relation(fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  @@index([tenantId, subjectId])
}

model CascadeParent {
  id        String @id
  tenantId  String
  subjectId String
  email     String @unique
  children  CascadeChild[]
}

model CascadeChild {
  id        String @id
  tenantId  String
  subjectId String
  ownerEmail String
  total     Int
  parent    CascadeParent @relation(fields: [ownerEmail], references: [email], onDelete: Restrict, onUpdate: Cascade)
  @@index([tenantId, subjectId])
}

model DataSubjectRequest {
  id            String @id
  tenantId      String
  subjectId     String
  type          String
  state         String
  createdAt     DateTime
  dueAt         DateTime
  completedAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  artifactHash  String?
  artifactUrl   String?
  stats         Json?
  requestedBy   String?
  execution     DataSubjectExecution?
  @@index([tenantId, subjectId])
  @@index([state, dueAt])
}

model DataSubjectExecution {
  requestId      String @id
  tenantId       String
  type           String
  idempotencyKey String
  payloadHash    String
  record         Json
  request        DataSubjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@unique([tenantId, type, idempotencyKey])
}
