// Example schema for @nestarc/data-subject.
// Consumers copy the DataSubjectRequest model into their own schema.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DataSubjectRequest {
  id            String   @id @default(cuid())
  tenantId      String
  subjectId     String
  type          String
  state         String
  createdAt     DateTime @default(now())
  dueAt         DateTime
  completedAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  artifactHash  String?
  artifactUrl   String?
  stats         Json?
  requestedBy   String?
  execution     DataSubjectExecution?

  @@index([tenantId, subjectId])
  @@index([state, dueAt])
}

// Required for PrismaExecutionStore. Contains retry bytes, so apply the same
// access control and explicit retention policy as the exported personal data.
model DataSubjectExecution {
  requestId      String @id
  tenantId       String
  type           String
  idempotencyKey String
  payloadHash    String
  record         Json
  request        DataSubjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, idempotencyKey])
}
